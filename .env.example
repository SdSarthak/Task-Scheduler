# Copy to .env and adjust. Every value below is optional; the defaults shown
# are what the application uses when the variable is unset.

# Where tasks are persisted. Relative paths are resolved from the working
# directory the app is launched from.
TASK_SCHEDULER_DATA_FILE=tasks.json

# How many days ahead the summary/statistics view treats as "upcoming".
TASK_SCHEDULER_UPCOMING_DAYS=3

# Keep a timestamped backup when an unreadable tasks file is replaced.
# Set to 0/false to overwrite corrupt files without a backup.
TASK_SCHEDULER_BACKUP_CORRUPT=1
